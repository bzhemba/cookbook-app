        <div class="user-menu">
            <a href="/profile">Welcome, {{user.name}}!</a>
            <a href="/logout">Logout</a>
        </div>
        <nav class="nav">
            <ul>
                <li><a href="/all-recipes" class="all-recipes">all recipes</a></li>
